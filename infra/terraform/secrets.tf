# Passwords are ephemeral (generated during the run, never stored in state) and written to
# Secrets Manager through a write-only argument. Servers read them at boot with their role.
# To rotate: bump secret_version, apply, re-run the platform configuration on the servers.

locals {
  secret_version = 1
}

ephemeral "random_password" "login" {
  for_each         = local.logins
  length           = 32
  override_special = "!#%*-_=+" # safe inside T-SQL, PowerShell and server.hsconf
}

ephemeral "random_password" "cache" {
  length           = 32
  override_special = "!#%*-_=+"
}

resource "aws_secretsmanager_secret" "platform" {
  name                    = "${local.name}/outsystems"
  description             = "OutSystems database logins and RabbitMQ credentials"
  kms_key_id              = aws_kms_key.this.arn
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "platform" {
  secret_id = aws_secretsmanager_secret.platform.id
  secret_string_wo = jsonencode(merge(
    { for k, login in local.logins : "${k}_user" => login },
    { for k, _ in local.logins : "${k}_password" => ephemeral.random_password.login[k].result },
    { cache_user = "osrabbit", cache_password = ephemeral.random_password.cache.result }
  ))
  secret_string_wo_version = local.secret_version
}

# All servers of a farm must share the controller's private.key. The controller writes it
# here on first boot; front-ends wait for it before configuring themselves.
resource "aws_secretsmanager_secret" "private_key" {
  name                    = "${local.name}/outsystems-private-key"
  description             = "OutSystems private.key generated by the controller"
  kms_key_id              = aws_kms_key.this.arn
  recovery_window_in_days = 7
}

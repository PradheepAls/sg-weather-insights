# Platform passwords are generated as ephemeral values and written with write-only arguments,
# so they exist in Secrets Manager but never in Terraform state or plan output.
# Rotate by incrementing `secret_version` below, then re-running the server configuration step.

locals {
  secret_version = 1
}

ephemeral "random_password" "db" {
  for_each         = local.logins
  length           = 32
  special          = true
  override_special = "!#%*-_=+" # safe inside T-SQL, PowerShell and server.hsconf
  min_upper        = 2
  min_lower        = 2
  min_numeric      = 2
}

ephemeral "random_password" "cache" {
  length           = 32
  special          = true
  override_special = "!#%*-_=+"
}

resource "aws_secretsmanager_secret" "platform" {
  name                    = "${local.name}/outsystems/platform"
  description             = "OutSystems DB logins and RabbitMQ credentials for ${local.name}"
  kms_key_id              = var.kms_key_arn
  recovery_window_in_days = var.is_production ? 30 : 7
  tags                    = local.tags
}

resource "aws_secretsmanager_secret_version" "platform" {
  secret_id = aws_secretsmanager_secret.platform.id
  secret_string_wo = jsonencode(merge(
    { for k, login in local.logins : "${k}_user" => login },
    { for k, _ in local.logins : "${k}_password" => ephemeral.random_password.db[k].result },
    { cache_user = "osrabbit", cache_password = ephemeral.random_password.cache.result }
  ))
  secret_string_wo_version = local.secret_version
}

# Every server in a farm must share the controller's private.key (it encrypts server.hsconf
# values and session data). The controller writes it here at first boot; front-ends read it.
resource "aws_secretsmanager_secret" "private_key" {
  name                    = "${local.name}/outsystems/private-key"
  description             = "OutSystems private.key generated by the ${local.name} controller"
  kms_key_id              = var.kms_key_arn
  recovery_window_in_days = var.is_production ? 30 : 7
  tags                    = local.tags
}

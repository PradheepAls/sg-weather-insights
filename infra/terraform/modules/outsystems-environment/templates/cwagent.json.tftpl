{
  "agent": { "metrics_collection_interval": 60 },
  "metrics": {
    "namespace": "${namespace}",
    "append_dimensions": { "InstanceId": "$${aws:InstanceId}", "AutoScalingGroupName": "$${aws:AutoScalingGroupName}" },
    "aggregation_dimensions": [["InstanceId"], ["AutoScalingGroupName"]],
    "metrics_collected": {
      "Memory": { "measurement": ["% Committed Bytes In Use"] },
      "LogicalDisk": { "measurement": ["% Free Space"], "resources": ["C:"] },
      "Processor": { "measurement": ["% Processor Time"], "resources": ["_Total"] },
      "ASP.NET Applications": { "measurement": ["Requests In Application Queue", "Requests/Sec"], "resources": ["__Total__"] },
      "W3SVC_W3WP": { "measurement": ["Active Requests"], "resources": ["_Total"] }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "C:\\ProgramData\\sgw\\*.log", "log_group_name": "${log_bootstrap}", "log_stream_name": "{instance_id}" },
          { "file_path": "C:\\Program Files\\OutSystems\\Platform Server\\logs\\*.log", "log_group_name": "${log_outsystems}", "log_stream_name": "{instance_id}" },
          { "file_path": "C:\\inetpub\\logs\\LogFiles\\W3SVC1\\*.log", "log_group_name": "${log_iis}", "log_stream_name": "{instance_id}" }
        ]
      },
      "windows_events": {
        "collect_list": [
          { "event_name": "Application", "event_levels": ["ERROR", "WARNING"], "log_group_name": "${log_windows}", "log_stream_name": "{instance_id}/application" },
          { "event_name": "System", "event_levels": ["ERROR", "WARNING"], "log_group_name": "${log_windows}", "log_stream_name": "{instance_id}/system" }
        ]
      }
    }
  }
}
